d9\u05d5\u05e0\u05d5\u05ea \u05d1\u05e7\u05e9\u05ea \u05d7\u05e0\u05d9\u05e0\u05d4 \u05d1\u05e9\u05de\u05d5 \u05d5\u05e0\u05ea\u05dc\u05d4 \u05d1\u05db\u05dc\u05d0 \u05e2\u05db\u05d5.", "description:he": "\u05ea\u05e6\u05e4\u05d9\u05ea \u05dc\u05db\u05e0\u05e8\u05ea, \u05dc\u05d2\u05d5\u05dc\u05df, \u05d5\u05dc\u05d3\u05e8\u05d5\u05dd \u05e2\u05de\u05e7 \u05d4\u05d7\u05d5\u05dc\u05d4. \u05e9\u05dc\u05de\u05d4 \u05d1\u05df \u05d9\u05d5\u05e1\u05e3 \u05e2\u05dc\u05d4 \u05dc\u05d0\u05e8\u05e5 \u05d1-1937 \u05d5\u05d4\u05ea\u05d9\u05d9\u05e9\u05d1 \u05d1\u05e8\u05d0\u05e9 \u05e4\u05d9\u05e0\u05d4. \u05d1-1938 \u05d1\u05d5\u05e6\u05e2\u05d5 \u05de\u05e1\u05e4\u05e8 \u05d4\u05ea\u05e7\u05e4\u05d5\u05ea \u05e2\u05dc \u05e9\u05d9\u05d9\u05e8\u05d5\u05ea \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05d1\u05db\u05d1\u05d9\u05e9 \u05e2\u05db\u05d5-\u05e8\u05d0\u05e9 \u05e4\u05d9\u05e0\u05d4. \u05e9\u05dc\u05de\u05d4 \u05d5\u05e2\u05d5\u05d3 \u05e9\u05e0\u05d9\u05d9\u05dd \u05d4\u05d7\u05dc\u05d9\u05d8\u05d5 \u05dc\u05e0\u05e7\u05d5\u05dd, \u05e0\u05db\u05e9\u05dc\u05d5, \u05d5\u05e0\u05ea\u05e4\u05e1\u05d5. \u05d4\u05d5\u05d0 \u05e1\u05d9\u05e8\u05d1 \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d1\u05e7\u05e9\u05ea \u05d7\u05e0\u05d9\u05e0\u05d4 \u05d1\u05e9\u05de\u05d5 \u05d5\u05e0\u05ea\u05dc\u05d4 \u05d1\u05db\u05dc\u05d0 \u05e2\u05db\u05d5.", "image": "https://upload.wikimedia.org/wikipedia/commons/0/04/IHM_\u05de\u05e6\u05e4\u05d5\u05e8_\u05e9\u05dc\u05de\u05d4_\u05d1\u05df_\u05d9\u05d5\u05e1\u05e3.jpeg", "name": "\u05de\u05e6\u05e4\u05d5\u05e8 \u05e9\u05dc\u05de\u05d4 \u05d1\u05df \u05d9\u05d5\u05e1\u05e3", "name:he": "\u05de\u05e6\u05e4\u05d5\u05e8 \u05e9\u05dc\u05de\u05d4 \u05d1\u05df \u05d9\u05d5\u05e1\u05e3", "tourism": "viewpoint"}}]}